# Configurazione Lingua Italiana
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LANGUAGE=it_IT:it
echo "export LANG=C.UTF-8" >> /etc/profile
echo "export LC_ALL=C.UTF-8" >> /etc/profile
echo "export LANGUAGE=it_IT:it" >> /etc/profile
echo "export LANG=C.UTF-8" >> /root/.bashrc
echo "export LC_ALL=C.UTF-8" >> /root/.bashrc
echo "export LANGUAGE=it_IT:it" >> /root/.bashrc

# VNI 300 — LAN T
ip address add 2.0.0.226/27 dev eth0
# llm è in modalità bridged, quindi mantiene il default route di Docker su eth1 per il port forwarding.
# Aggiungiamo rotte specifiche per far raggiungere le reti interne del Data Center (Admin, AS1, AS3 ecc.)
ip route add 10.0.0.0/8 via 2.0.0.225 dev eth0
ip route add 192.168.0.0/16 via 2.0.0.225 dev eth0
ip route add 1.0.0.0/8 via 2.0.0.225 dev eth0
echo "nameserver 10.1.0.2" > /etc/resolv.conf

# Necessario affinché Ollama accetti connessioni da tutta la rete (non solo localhost)
export OLLAMA_HOST=0.0.0.0:11434

# Avvio Ollama server in background
ollama serve &

# Attendi che il server sia pronto (curl non è installato: usiamo il builtin bash /dev/tcp)
echo "Attesa avvio Ollama..."
until bash -c "echo >/dev/tcp/localhost/11434" 2>/dev/null; do
    sleep 2
done
echo "Ollama pronto."

# Pull dei modelli (saltato se già presenti — ollama pull è idempotente)
ollama pull llama3.2:3b
ollama pull qwen3.5:9b
