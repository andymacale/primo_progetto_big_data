ip address add 1.0.0.2/30 dev eth0
ip address add 100.0.0.17/30 dev eth1
ip address add 100.0.0.21/30 dev eth2
ip address add 10.0.0.1/16 dev eth3
ip address add 10.1.0.1/16 dev eth4

# Enable interfaces
ip link set up dev eth0
ip link set up dev eth1
ip link set up dev eth2
ip link set up dev eth3
ip link set up dev eth4

# Aggregate routes (will be overridden by specific BGP routes)
ip route add blackhole 10.0.0.0/8
ip route add blackhole 2.0.0.128/25

systemctl start frr

# Avvio del demone Firewall perimetrale del Data Center (unbuffered)
python3 -u /firewall_daemon.py > /var/log/firewall_daemon.log 2>&1 &