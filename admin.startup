# Configurazione Lingua Italiana
export LANG=it_IT.UTF-8
export LC_ALL=it_IT.UTF-8
export LANGUAGE=it_IT:it
echo "export LANG=it_IT.UTF-8" >> /etc/profile
echo "export LC_ALL=it_IT.UTF-8" >> /etc/profile
echo "export LANGUAGE=it_IT:it" >> /etc/profile
echo "export LANG=it_IT.UTF-8" >> /root/.bashrc
echo "export LC_ALL=it_IT.UTF-8" >> /root/.bashrc
echo "export LANGUAGE=it_IT:it" >> /root/.bashrc

ln -sf /usr/share/zoneinfo/Europe/Rome /etc/localtime
ip address add 10.0.0.2/16 dev eth0
ip route add default via 10.0.0.1 dev eth0

# Risoluzione nomi per i servizi del Data Lake
echo "2.0.0.194 spark-master" >> /etc/hosts
echo "2.0.0.195 mongo.cyber.net" >> /etc/hosts

sleep 15
bash /app/gestisci_app.sh start

# Sincronizza le regole firewall pre-esistenti sul web_server
python3 /app/sync_firewall.py > /var/log/sync_firewall.log 2>&1

# Avvia l'ingestore PCAP per analizzare il traffico in background
python3 /app/pcap_ingestor.py > /var/log/pcap_ingestor.log 2>&1 &