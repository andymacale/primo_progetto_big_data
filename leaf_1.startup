# Configurazione Lingua Italiana
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LANGUAGE=it_IT:it
echo "export LANG=C.UTF-8" >> /etc/profile
echo "export LC_ALL=C.UTF-8" >> /etc/profile
echo "export LANGUAGE=it_IT:it" >> /etc/profile
echo "export LANG=C.UTF-8" >> /root/.bashrc
echo "export LC_ALL=C.UTF-8" >> /root/.bashrc
echo "export LANGUAGE=it_IT:it" >> /root/.bashrc

# Create loopback
ip address add 10.255.0.5/32 dev lo
ip route add 10.255.0.5/32 dev lo

# Setting up VXLAN interfaces
# VNI 100: LAN R (web_server + sniffer)
ip link add vtep100 type vxlan id 100 dev lo dstport 4789 local 10.255.0.5 nolearning

# Creating bridge for LAN R
ip link add br100 type bridge
ip link set br100 addrgenmode none
ip addr add 2.0.0.129/26 dev br100

# Attach VTEP and server-facing interface (eth0=R) to bridge
ip link set dev vtep100 master br100 addrgenmode none
ip link set vtep100 type bridge_slave neigh_suppress on learning off
ip link set dev eth0 master br100

# Enable bridge VLANs
ip link set dev br100 type bridge vlan_filtering 1
bridge vlan add vid 100 dev vtep100 pvid untagged
bridge vlan add vid 100 dev eth0 pvid untagged
bridge vlan add vid 100 dev br100 self pvid untagged

# Enable interfaces
ip link set up dev vtep100
ip link set up dev br100
ip link set up dev eth0
ip link set up dev eth1
ip link set up dev eth2

# VNI 200
ip link add vtep200 type vxlan id 200 dev lo dstport 4789 local 10.255.0.5 nolearning
ip link add br200 type bridge
ip link set br200 addrgenmode none
ip address add 2.0.0.193/27 dev br200
ip link set dev vtep200 master br200 addrgenmode none
ip link set vtep200 type bridge_slave neigh_suppress on learning off
ip link set dev br200 type bridge vlan_filtering 1
bridge vlan add vid 200 dev vtep200 pvid untagged
bridge vlan add vid 200 dev br200 self pvid untagged
ip link set up dev vtep200
ip link set up dev br200

# VNI 300
ip link add vtep300 type vxlan id 300 dev lo dstport 4789 local 10.255.0.5 nolearning
ip link add br300 type bridge
ip link set br300 addrgenmode none
ip address add 2.0.0.225/27 dev br300
ip link set dev vtep300 master br300 addrgenmode none
ip link set vtep300 type bridge_slave neigh_suppress on learning off
ip link set dev br300 type bridge vlan_filtering 1
bridge vlan add vid 300 dev vtep300 pvid untagged
bridge vlan add vid 300 dev br300 self pvid untagged
ip link set up dev vtep300
ip link set up dev br300

systemctl start frr
