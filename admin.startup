# Configurazione Lingua Italiana
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LANGUAGE=it_IT:it
echo "export LANG=C.UTF-8" >> /etc/profile
echo "export LC_ALL=C.UTF-8" >> /etc/profile
echo "export LANGUAGE=it_IT:it" >> /etc/profile
echo "export LANG=C.UTF-8" >> /root/.bashrc
echo "export LC_ALL=C.UTF-8" >> /root/.bashrc
echo "export LANGUAGE=it_IT:it" >> /root/.bashrc

ln -sf /usr/share/zoneinfo/Europe/Rome /etc/localtime
ip address add 10.0.0.2/16 dev eth0
# Poichè admin è in bridged mode per esporre la porta 8080, Docker fornisce una rotta di default.
# Dobbiamo inserire rotte specifiche per far comunicare admin con le reti del lab tramite r5 (10.0.0.1)
ip route add 10.0.0.0/8 via 10.0.0.1 dev eth0
ip route add 2.0.0.0/8 via 10.0.0.1 dev eth0
ip route add 192.168.0.0/16 via 10.0.0.1 dev eth0
ip route add 1.0.0.0/8 via 10.0.0.1 dev eth0
ip route add 100.0.0.0/8 via 10.0.0.1 dev eth0

# Risoluzione nomi per i servizi del Data Lake
echo "2.0.0.194 spark-master" >> /etc/hosts
echo "2.0.0.195 mongo.cyber.net" >> /etc/hosts

sleep 15
bash /app/gestisci_app.sh start

# Sincronizza le regole firewall pre-esistenti sul web_server
python3 /app/sync_firewall.py > /var/log/sync_firewall.log 2>&1

# Avvia l'ingestore PCAP per analizzare il traffico in background
python3 /app/pcap_ingestor.py > /var/log/pcap_ingestor.log 2>&1 &