# Configurazione Lingua Italiana
export LANG=it_IT.UTF-8
export LC_ALL=it_IT.UTF-8
export LANGUAGE=it_IT:it
echo "export LANG=it_IT.UTF-8" >> /etc/profile
echo "export LC_ALL=it_IT.UTF-8" >> /etc/profile
echo "export LANGUAGE=it_IT:it" >> /etc/profile
echo "export LANG=it_IT.UTF-8" >> /root/.bashrc
echo "export LC_ALL=it_IT.UTF-8" >> /root/.bashrc
echo "export LANGUAGE=it_IT:it" >> /root/.bashrc

ip address add 100.0.0.38/30 dev eth0
ip address add 2.0.0.1/26 dev eth1
systemctl start frr